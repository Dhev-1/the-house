[%General]
author=the house
comment=Qt on the noir table. A colours-only theme over Kvantum's default assets, regenerated by the house's scripts/apply-theme.sh on every table change.
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=0
toolbar_interior_spacing=2
spread_progressbar=true
composite=true
menu_shadow_depth=7
tooltip_shadow_depth=6
splitter_width=1
scroll_width=9
scroll_arrows=false
scroll_min_extent=50
slider_width=4
slider_handle_width=18
slider_handle_length=18
tickless_slider_handle_size=18
check_size=16
textless_progressbar=false
progressbar_thickness=4
menubar_mouse_tracking=true
toolbutton_style=1
double_click=false
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=false
spin_button_width=24
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
combo_as_lineedit=true
animate_states=true
button_contents_shift=false
transparent_ktitle_label=true
dark_titlebar=true
respect_DE=true

[Hacks]
transparent_dolphin_view=false
blur_translucent=false
transparent_menutitle=false
respect_darkness=true
kcapacitybar_as_progressbar=true
force_size_grip=true
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=70
lxqtmainmenu_iconsize=22
normal_default_pushbutton=true
single_top_toolbar=true
tint_on_mouseover=0
transparent_pcmanfm_sidepane=false
transparent_pcmanfm_view=false
no_selection_tint=true
kinetic_scrolling=false
scroll_jump_workaround=false
middle_click_scroll=false
opaque_colors=false
[GeneralColors]
window.color=#141011
inactive.window.color=#110e0f
base.color=#0e0b0d
inactive.base.color=#0e0b0d
alt.base.color=#141011
button.color=#2a2320
light.color=#443d3a
mid.light.color=#362f2c
dark.color=#140d0a
mid.color=#1f1815
highlight.color=#d4af5f
inactive.highlight.color=#7b653a
text.color=#e8ddc4
inactive.text.color=#8a7f6d
window.text.color=#e8ddc4
inactive.window.text.color=#8a7f6d
button.text.color=#e8ddc4
disabled.text.color=#5f564b
tooltip.text.color=#e8ddc4
highlight.text.color=#0e0b0d
inactive.highlight.text.color=#e8ddc4
link.color=#d4af5f
link.visited.color=#cb7557
progress.indicator.text.color=#0e0b0d

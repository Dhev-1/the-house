/* rofi — the house pit boss.
 * Theme lives in ~/.config/rofi/themes/house.rasi (Noir table colours). */

@theme "~/.config/rofi/themes/house.rasi"

/* ---- Configuration ---- */
configuration {
    modi:                    "drun,run,filebrowser";
    show-icons:              false;
    display-drun:            "♠ apps";
    display-run:             "♦ term";
    display-filebrowser:     "♣ files";
    display-window:          "♥ window";
    drun-display-format:     "{name}";
    hover-select:            true;
    me-select-entry:         "MouseSecondary";
    me-accept-entry:         "MousePrimary";
    window-format:           "{w} · {c} · {t}";
}

/* house.rasi — the Noir table.
 * Black lacquer window, champagne-gold selection, ivory text.
 * Loaded from ../config.rasi. */

* {
    surface:                 #0e0b0dE6;
    lacquer:                 #1e1813;
    gold:                    #d4af5f;
    ivory:                   #e8ddc4;
    smoke:                   #8a7f6d;
    crimson:                 #c13a4e;

    background-color:        transparent;
    text-color:              @ivory;
    border-color:            @gold;
}

/* ---- Window ---- */
window {
    enabled:                 true;
    fullscreen:              false;
    transparency:            "real";
    cursor:                  "default";
    spacing:                 0px;
    border:                  2px;
    border-radius:           12px;
    location:                center;
    anchor:                  center;
    width:                   40%;
    background-color:        @surface;
}

/* ----- Main Box ----- */
mainbox {
    enabled:                 true;
    orientation:             vertical;
    children:                [ "inputbar", "listbox" ];
}

/* ---- Inputbar ---- */
inputbar {
    enabled:                 true;
    padding:                 8px;
    margin:                  10px;
    orientation:             horizontal;
    children:                [ "prompt", "entry" ];
    border:                  0px 0px 1px 0px;
    border-color:            #2a2320;
}

prompt {
    enabled:                 true;
    padding:                 8px 4px 8px 8px;
    text-color:              @gold;
}

/* ---- Entry input ---- */
entry {
    enabled:                 true;
    expand:                  true;
    width:                   100%;
    padding:                 8px;
    cursor:                  text;
    placeholder:             "place your bets ";
    placeholder-color:       @smoke;
}

/* ---- Listbox ---- */
listbox {
    spacing:                 0px;
    padding:                 0px 10px 10px 10px;
    orientation:             vertical;
    children:                [ "message", "listview" ];
}

/* ---- Listview ---- */
listview {
    enabled:                 true;
    columns:                 1;
    lines:                   7;
    cycle:                   true;
    dynamic:                 true;
    scrollbar:               false;
    layout:                  vertical;
    reverse:                 false;
    fixed-height:            true;
    fixed-columns:           true;
    spacing:                 2px;
    padding:                 0px;
    border:                  0px;
}

/* ---- Elements ---- */
element {
    enabled:                 true;
    spacing:                 8px;
    padding:                 8px;
    border-radius:           8px;
    cursor:                  pointer;
}

element normal.normal {
    text-color:              @ivory;
}
element normal.urgent {
    text-color:              @crimson;
}
element normal.active {
    text-color:              @gold;
}

element selected.normal {
    background-color:        @gold;
    text-color:              #0e0b0d;
}
element selected.urgent {
    background-color:        @crimson;
    text-color:              @ivory;
}
element selected.active {
    background-color:        @gold;
    text-color:              #0e0b0d;
}

element alternate.normal {
    text-color:              @ivory;
}
element alternate.urgent {
    text-color:              @crimson;
}
element alternate.active {
    text-color:              @gold;
}

element-icon {
    text-color:              inherit;
    size:                    28px;
    cursor:                  inherit;
}

element-text {
    text-color:              inherit;
    cursor:                  inherit;
    vertical-align:          0.5;
    horizontal-align:        0.0;
}

/* ---- Message ---- */
message {
    border:                  0px;
}

textbox {
    margin:                  10px;
    padding:                 8px;
    border-radius:           8px;
    background-color:        @lacquer;
    text-color:              @ivory;
    vertical-align:          0.5;
    horizontal-align:        0.5;
}

error-message {
    padding:                 8px;
    background-color:        @lacquer;
    text-color:              @crimson;
}
